{
  "name": "@kellanjs/keycraft",
  "version": "0.1.0",
  "description": "Type-safe query key manager for TanStack Query and other state management libraries.",
  "keywords": [
    "react-query",
    "tanstack-query",
    "query-keys",
    "cache-management",
    "typescript",
    "type-safety",
    "type-inference",
    "fluent-api",
    "query-client",
    "cache-invalidation",
    "tanstack",
    "react",
    "state-management",
    "dx"
  ],
  "author": "kellanjs",
  "license": "MIT",
  "homepage": "https://github.com/kellanjs/keycraft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kellanjs/keycraft.git"
  },
  "bugs": {
    "url": "https://github.com/kellanjs/keycraft/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vitest",
    "build": "tsc",
    "lint": "eslint .",
    "type": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "ci": "npm run lint && npm run type && npm run build && npm run check-format && npm run check-exports && npm run test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^9.39.0",
    "@tanstack/react-query": "^5.90.16",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.8"
  }
}
